# ==============================================================================
# AI Lead Automation - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and populate with appropriate values.
# DO NOT commit real secrets or credentials to version control.
# ==============================================================================

# Core Workflow Orchestration (Planned Milestone 0.1)
N8N_WEBHOOK_URL=http://localhost:5678/webhook/leads/incoming
N8N_API_KEY=your_n8n_api_key_here

# AI Model Provider (Planned Milestone 0.1)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# CRM Integration (Planned Milestone 0.2)
HUBSPOT_ACCESS_TOKEN=your_hubspot_private_app_token_here

# Notifications & Alerts (Planned Milestone 0.4)
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/xxx/yyy/zzz
INTERNAL_SALES_NOTIFICATION_EMAIL=sales-team@example.com

# Meta / Facebook Lead Ads (Planned Milestone 1.1)
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_PAGE_ACCESS_TOKEN=your_meta_page_access_token_here
META_WEBHOOK_VERIFY_TOKEN=your_custom_verify_token_here

# LINE Official Account (Planned Milestone 2.0)
LINE_CHANNEL_ID=your_line_channel_id_here
LINE_CHANNEL_SECRET=your_line_channel_secret_here
LINE_CHANNEL_ACCESS_TOKEN=your_line_channel_access_token_here
