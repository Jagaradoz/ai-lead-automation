# ==============================================================================
# AI Lead Automation - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in what you need. Never commit real secrets.
#
# Everything under "Model" can also be set from the app: Settings > Model.
# Values saved in the app (data/settings.json) take precedence over these,
# except an API key left blank in the app, which falls back to the key here.
# ==============================================================================

# --- Model used to read leads -------------------------------------------------
# LLM_PROVIDER: none | anthropic | openai | openrouter | groq | deepseek | gemini
#               | ollama | lmstudio | custom (any OpenAI-compatible server)
LLM_PROVIDER=none
LLM_MODEL=
# Only needed for "custom", or to override a provider's default URL
LLM_BASE_URL=
LLM_API_KEY=
LLM_TIMEOUT_S=60

# Provider-specific keys are also picked up (used when LLM_API_KEY is empty)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=
GEMINI_API_KEY=

# --- Server -------------------------------------------------------------------
PORT=8000
# Where settings, the business profile and the lead database are stored
DATA_DIR=./data
# When set, changing settings (model, API key, business profile) requires
# "Authorization: Bearer <token>". It does NOT protect lead data: anyone who can
# reach the server can read and export leads. Don't expose the server beyond
# your machine or team network without a login in front of it (e.g. a reverse proxy).
ADMIN_TOKEN=
# Host names the server answers to. Add your LAN name/IP if you run it with --host 0.0.0.0.
ALLOWED_HOSTS=127.0.0.1,localhost
# Comma-separated origins allowed to call the API from other sites (default: none)
CORS_ORIGINS=

# --- Downstream dispatch (optional) --------------------------------------------
# Used when a lead is processed with ?live_sync=true
HUBSPOT_ACCESS_TOKEN=
SLACK_WEBHOOK_URL=

# --- Planned integrations ---------------------------------------------------
N8N_WEBHOOK_URL=http://localhost:5678/webhook/leads/incoming
N8N_API_KEY=
INTERNAL_SALES_NOTIFICATION_EMAIL=
META_APP_ID=
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=
META_WEBHOOK_VERIFY_TOKEN=
LINE_CHANNEL_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
